# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real keys. See docs/architecture.md for the full backend plan.

# Frontend (safe to expose client-side; protected by RLS, not secrecy)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side only (Edge Function secrets, e.g. `supabase secrets set`)
# — never put this in a .env file that a build step could bundle client-side.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
